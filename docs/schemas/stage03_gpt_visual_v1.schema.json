{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oscardp:stage03:gpt-visual:v1",
  "title": "OscarDP Stage03 GPT Visual Annotation v1",
  "description": "Manually reviewed sparse-sample observations; no object or person BBoxes, no automated CV, no verified identity or continuous video claims.",
  "type": "object",
  "properties": {
    "movie_id": {
      "type": "string",
      "pattern": "^tt[0-9]{7,10}$"
    },
    "stage_version": {
      "const": "3.0"
    },
    "inputs": {
      "type": "object",
      "properties": {
        "frozen_release_id": {
          "type": "string",
          "minLength": 1
        },
        "frozen_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "stage01_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "stage02_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "frame_samples_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "frozen_release_id",
        "frozen_manifest_sha256",
        "stage01_sha256",
        "stage02_sha256",
        "frame_samples_sha256"
      ],
      "additionalProperties": false
    },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "shot_id": {
            "type": "string",
            "pattern": "^shot_[0-9]{6}$"
          },
          "samples": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "early",
                    "middle",
                    "late"
                  ]
                },
                "frame_index": {
                  "type": "integer",
                  "minimum": 0
                },
                "image_relpath": {
                  "type": "string",
                  "pattern": "^shot_img/shot_[0-9]{6}_(early|middle|late)\\.jpg$"
                },
                "image_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "role",
                "frame_index",
                "image_relpath",
                "image_sha256"
              ],
              "additionalProperties": false
            },
            "minItems": 3,
            "maxItems": 3
          },
          "visual": {
            "type": "object",
            "properties": {
              "shot_scale": {
                "type": "string",
                "enum": [
                  "ECU",
                  "CU",
                  "MCU",
                  "MS",
                  "MLS",
                  "LS",
                  "ELS",
                  "mixed",
                  "not_applicable",
                  "unknown"
                ]
              },
              "camera_angle": {
                "type": "string",
                "enum": [
                  "eye_level",
                  "high",
                  "low",
                  "overhead",
                  "unknown"
                ]
              },
              "camera_motion_evidence": {
                "type": "string",
                "enum": [
                  "no_evident_motion",
                  "possible_motion",
                  "unknown"
                ]
              },
              "primary_subject_position": {
                "type": "string",
                "enum": [
                  "left",
                  "center",
                  "right",
                  "multiple",
                  "not_applicable",
                  "unknown"
                ]
              },
              "over_the_shoulder": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "visual_focus": {
                "type": "string",
                "enum": [
                  "person",
                  "object",
                  "environment",
                  "mixed",
                  "unknown"
                ]
              },
              "evidence_roles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "early",
                    "middle",
                    "late"
                  ]
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "shot_scale",
              "camera_angle",
              "camera_motion_evidence",
              "primary_subject_position",
              "over_the_shoulder",
              "visual_focus",
              "evidence_roles"
            ],
            "additionalProperties": false
          },
          "subjects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "subject_id": {
                  "type": "string",
                  "pattern": "^subject_[0-9]{3,}$"
                },
                "evidence_roles": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "early",
                      "middle",
                      "late"
                    ]
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "subject_facing": {
                  "type": "string",
                  "enum": [
                    "frontal",
                    "three_quarter",
                    "profile",
                    "back",
                    "mixed",
                    "unknown"
                  ]
                },
                "face_visibility": {
                  "type": "string",
                  "enum": [
                    "fully_visible",
                    "partially_visible",
                    "not_visible",
                    "mixed",
                    "unknown"
                  ]
                },
                "face_quality": {
                  "type": "string",
                  "enum": [
                    "good",
                    "limited",
                    "unusable",
                    "mixed",
                    "not_applicable",
                    "unknown"
                  ]
                },
                "occlusion": {
                  "type": "string",
                  "enum": [
                    "none",
                    "partial",
                    "heavy",
                    "mixed",
                    "not_applicable",
                    "unknown"
                  ]
                },
                "appearance_mode": {
                  "type": "string",
                  "enum": [
                    "direct",
                    "reflection",
                    "screen_or_photo",
                    "unknown"
                  ]
                }
              },
              "required": [
                "subject_id",
                "evidence_roles",
                "subject_facing",
                "face_visibility",
                "face_quality",
                "occlusion",
                "appearance_mode"
              ],
              "additionalProperties": false
            }
          },
          "objects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "object_id": {
                  "type": "string",
                  "pattern": "^object_[0-9]{3,}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "object_framing": {
                  "type": "string",
                  "enum": [
                    "detail_closeup",
                    "prominent",
                    "contextual",
                    "unknown"
                  ]
                },
                "evidence_roles": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "early",
                      "middle",
                      "late"
                    ]
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "required": [
                "object_id",
                "label",
                "object_framing",
                "evidence_roles"
              ],
              "additionalProperties": false
            }
          },
          "visible_relations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "subject_id": {
                  "type": "string",
                  "pattern": "^subject_[0-9]{3,}$"
                },
                "object_id": {
                  "type": "string",
                  "pattern": "^object_[0-9]{3,}$"
                },
                "relation_type": {
                  "type": "string",
                  "enum": [
                    "holding",
                    "touching",
                    "wearing",
                    "sitting_on",
                    "leaning_on",
                    "near",
                    "uncertain"
                  ]
                },
                "evidence_roles": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "early",
                      "middle",
                      "late"
                    ]
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "required": [
                "subject_id",
                "object_id",
                "relation_type",
                "evidence_roles"
              ],
              "additionalProperties": false
            }
          },
          "review_status": {
            "type": "string",
            "enum": [
              "unreviewed",
              "model_reviewed",
              "human_verified",
              "human_corrected"
            ]
          },
          "visual_summary": {
            "type": "string"
          }
        },
        "required": [
          "shot_id",
          "samples",
          "visual",
          "subjects",
          "objects",
          "visible_relations",
          "review_status",
          "visual_summary"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "movie_id",
    "stage_version",
    "inputs",
    "shots"
  ],
  "additionalProperties": false
}
